# Use Debian Trixie based slim Python image to provide GLIBC >= 2.38 required by modern tools (such as apkeep >= 1.1.0)
ARG PYTHON_VERSION=3.15.2-slim-trixie

FROM python:${PYTHON_VERSION} AS python


# Set ARGs and ENVs
ARG APP_HOME=/app

ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1
WORKDIR ${APP_HOME}
ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en' LC_ALL='en_US.UTF-8'


# Update package lists and install required packages.
# Debian Trixie uses modern /etc/apt/keyrings instead of deprecated apt-key and does not package software-properties-common.
RUN apt-get -qq update && \
    apt-get -qq -y --no-install-recommends install gnupg locales curl tzdata git && \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen en_US.UTF-8 && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://repos.azul.com/azul-repo.key | gpg --dearmor -o /etc/apt/keyrings/azul.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/azul.gpg] https://repos.azul.com/zulu/deb stable main" > /etc/apt/sources.list.d/zulu.list && \
    apt-get -qq update && \
    apt-get -qq -y upgrade && \
    mkdir -p /usr/share/man/man1 && \
    # Pin and install Azul Zulu Java 21 JDK to meet the minimum Java 21 requirement.
    echo "Package: zulu21-*\nPin-Priority: 1001" > /etc/apt/preferences && \
    apt-get -qq -y --no-install-recommends install zulu21-jdk && \
    apt-get -qq -y purge gnupg curl && \
    apt-get -y autoremove && \
    rm -rf /var/lib/apt/lists/*

# Set Java home environment variable to the architecture-independent Zulu 21 symlink.
ENV JAVA_HOME=/usr/lib/jvm/zulu21

# libssl3 (or libssl3t64 in trixie) provides libssl/libcrypto needed by apkeep; curl and jq are used to resolve and download the binary.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl jq libssl3 && \
    rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/bin:${PATH}"
# Fetch the latest apkeep release dynamically for the host architecture.
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "$ARCH" in \
        x86_64) ARCH_NAME="x86_64-unknown-linux-gnu" ;; \
        aarch64) ARCH_NAME="aarch64-unknown-linux-gnu" ;; \
        *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac; \
    URL=$(curl -s https://api.github.com/repos/EFForg/apkeep/releases/latest \
        | jq -r ".assets[] | select(.name == \"apkeep-${ARCH_NAME}\") | .browser_download_url"); \
    curl -L "$URL" -o /usr/local/bin/apkeep; \
    chmod +x /usr/local/bin/apkeep; \
    echo "Installed apkeep from $URL"; \
    /usr/local/bin/apkeep --version

CMD ["bash"]
